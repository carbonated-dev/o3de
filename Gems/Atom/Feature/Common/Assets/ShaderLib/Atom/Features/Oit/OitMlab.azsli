#pragma once

#include <scenesrg.srgi>
#include <Atom/Features/Oit/OitCommon.azsli>

bool OitIsMlabEnabled()
{
    return o_oitMethod == OitMethod::Mlab;
}

void OitMlabInsertFragment(uint2 pixelCoord, float depth, float3 premultipliedColor, float3 transmission)
{
    const float3 fragmentTransmission = saturate(transmission);
    const uint nodeCapacity = OitGetMlabFragmentCount(SceneSrg::m_oitMlabLayerCount);
    const float fragmentDepth = saturate(depth);
    const uint sampleCount = min(PassSrg::m_oitFragmentCount[pixelCoord], nodeCapacity);

    float depthNodes[OitMlabMaxFragmentCount + 1];
    float3 transmissionNodes[OitMlabMaxFragmentCount + 1];
    float3 colorNodes[OitMlabMaxFragmentCount + 1];

    // Read the stored nodes and choose the insertion point in reverse-depth order.
    uint insertIndex = sampleCount;
    [loop]
    for (uint nodeIndex = 0; nodeIndex < sampleCount; ++nodeIndex)
    {
        const uint2 atlasCoord = OitGetMlabAtlasCoord(pixelCoord, nodeIndex, nodeCapacity);
        const float4 colorNode = PassSrg::m_oitFragmentData0[atlasCoord];
        const float4 depthTransmissionNode = PassSrg::m_oitFragmentData1[atlasCoord];
        colorNodes[nodeIndex] = float3(colorNode.rgb);
        transmissionNodes[nodeIndex] = depthTransmissionNode.yzw;
        depthNodes[nodeIndex] = float(depthTransmissionNode.x);

        if (insertIndex == sampleCount && fragmentDepth >= depthNodes[nodeIndex])
        {
            insertIndex = nodeIndex;
        }
    }

    // Shift only the nodes that are behind the new fragment. The extra slot holds overflow for the merge below.
    for (int nodeIndex = int(sampleCount) - 1; nodeIndex >= int(insertIndex); --nodeIndex)
    {
        depthNodes[nodeIndex + 1] = depthNodes[nodeIndex];
        transmissionNodes[nodeIndex + 1] = transmissionNodes[nodeIndex];
        colorNodes[nodeIndex + 1] = colorNodes[nodeIndex];
    }

    // Insert the new value
    depthNodes[insertIndex] = fragmentDepth;
    transmissionNodes[insertIndex] = fragmentTransmission;
    colorNodes[insertIndex] = premultipliedColor;

    // If the list overflows, fold the farthest two nodes together so the node count stays capped.
    const uint newSampleCount = sampleCount + 1;
    if (newSampleCount > nodeCapacity)
    {
        colorNodes[nodeCapacity - 1] += transmissionNodes[nodeCapacity - 1] * colorNodes[nodeCapacity];
        transmissionNodes[nodeCapacity - 1] = saturate(transmissionNodes[nodeCapacity - 1] * transmissionNodes[nodeCapacity]);
        depthNodes[nodeCapacity - 1] = max(depthNodes[nodeCapacity - 1], depthNodes[nodeCapacity]);
    }

    // Write only live nodes. Resolve uses the stored count, so unused atlas slots do not need to be cleared here.
    const uint nodeWriteCount = min(newSampleCount, nodeCapacity);
    for (uint nodeIndex = 0; nodeIndex < nodeWriteCount; ++nodeIndex)
    {
        const uint2 atlasCoord = OitGetMlabAtlasCoord(pixelCoord, nodeIndex, nodeCapacity);
        PassSrg::m_oitFragmentData0[atlasCoord] = float4(colorNodes[nodeIndex], 0.0f);
        PassSrg::m_oitFragmentData1[atlasCoord] = float4(depthNodes[nodeIndex], transmissionNodes[nodeIndex]);
    }

    PassSrg::m_oitFragmentCount[pixelCoord] = nodeWriteCount;
}
