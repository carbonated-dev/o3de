#pragma once

#include <scenesrg.srgi>
#include <Atom/Features/Oit/OitCommon.azsli>

bool OitIsWboitEnabled()
{
    return o_oitMethod == OitMethod::Wboit;
}

float OitWboitComputeWeight(float depth, float alpha)
{
    // Reverse depth is larger near the camera in Atom, so this favors nearer and more opaque fragments.
    const float reverseDepthFactor = max(saturate(depth), SceneSrg::m_oitWboitWeightBias);
    const float opacityFactor = max(saturate(alpha), SceneSrg::m_oitWboitWeightBias);
    return min(opacityFactor * reverseDepthFactor * SceneSrg::m_oitWboitWeightScale, SceneSrg::m_oitWboitWeightMax);
}

void OitWboitAccumulateFragment(uint2 pixelCoord, float depth, float3 premultipliedColor, float alpha, float3 transmission)
{
    const float clampedAlpha = saturate(alpha);
    const float3 fragmentTransmission = saturate(transmission);

    const float weight = OitWboitComputeWeight(depth, clampedAlpha);
    const float4 accum = PassSrg::m_oitFragmentData0[pixelCoord];
    const float4 revealage = PassSrg::m_oitFragmentData1[pixelCoord];

    // ROV access serializes the read-modify-write sequence without changing fixed-function blend state.
    PassSrg::m_oitFragmentData0[pixelCoord] = accum + float4(premultipliedColor * weight, clampedAlpha * weight);
    PassSrg::m_oitFragmentData1[pixelCoord] = float4(revealage.rgb * fragmentTransmission, revealage.a * (1.0f - clampedAlpha));
}
