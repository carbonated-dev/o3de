#pragma once

// Must match AZ::Render::OitMethod. This is a global option so custom transparent shaders compile the active OIT path.
option enum class OitMethod {Off, Mlab, Wboit, Mboit} o_oitMethod = OitMethod::Off;

bool OitIsEnabled()
{
#if ENABLE_OIT
    return o_oitMethod != OitMethod::Off;
#else
    return false;
#endif
}

static const uint OitMlabMaxFragmentCount = 8;
static const half OitMlabEmptyDepth = half(0.0f);

uint OitGetMlabFragmentCount(uint requestedLayerCount)
{
    return clamp(requestedLayerCount, 1u, OitMlabMaxFragmentCount);
}

uint2 OitGetMlabAtlasCoord(uint2 pixelCoord, uint nodeIndex, uint layerCount)
{
    // MLAB stores per-pixel layers in a vertical atlas: screen Y selects the pixel row, nodeIndex selects the layer.
    return uint2(pixelCoord.x, pixelCoord.y * layerCount + nodeIndex);
}
