#pragma once

#ifndef ENABLE_OIT
#define ENABLE_OIT 1
#endif

#include <Atom/Features/Oit/OitMlab.azsli>
#include <Atom/Features/Oit/OitWboit.azsli>
#include <Atom/Features/Oit/OitMboit.azsli>

// Common shader entry point for transparent draw-list shaders. Callers store OIT data here,
// then return neutral color outputs or rely on their PSO write mask so attachment 0 is not changed.
void OitStoreTransparentFragment(
    uint2 pixelCoord,
    float depth,
    float alpha,
    float3 premultipliedColor,
    float3 transmission)
{
    if (OitIsMlabEnabled())
    {
        OitMlabInsertFragment(pixelCoord, depth, premultipliedColor, transmission);
    }
    else if (OitIsWboitEnabled())
    {
        OitWboitAccumulateFragment(pixelCoord, depth, premultipliedColor, alpha, transmission);
    }
    else if (OitIsMboitEnabled())
    {
        OitMboitAccumulateFragment(pixelCoord, depth, premultipliedColor, alpha, transmission);
    }
    else
    {
        return;
    }
}
