#include <scenesrg.srgi>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_inputColor;
    RWTexture2D<float4> m_outputColor;

    // Must match the struct in RadialBlurPass.cpp
    struct Constants
    {
        uint2 m_outputSize;
        float2 m_center;
        float m_amount;
        float m_innerRadius;
        uint m_sampleCount;
        float m_pad;
    };
    Constants m_constants;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    if (dispatchThreadID.x >= PassSrg::m_constants.m_outputSize.x || dispatchThreadID.y >= PassSrg::m_constants.m_outputSize.y)
    {
        return;
    }

    uint2 pixel = dispatchThreadID.xy;
    float2 textureSize = float2(PassSrg::m_constants.m_outputSize);
    float2 uv = (float2(pixel) + 0.5f) / textureSize;
    float2 center = PassSrg::m_constants.m_center;
    float2 direction = uv - center;

    float2 maxDistanceVector = max(center, float2(1.0f, 1.0f) - center);
    float maxDistance = max(length(maxDistanceVector), 0.0001f);
    float normalizedDistance = length(direction) / maxDistance;

    float4 originalColor = PassSrg::m_inputColor[pixel];
    if (normalizedDistance <= PassSrg::m_constants.m_innerRadius)
    {
        PassSrg::m_outputColor[pixel] = originalColor;
        return;
    }

    float mask = saturate((normalizedDistance - PassSrg::m_constants.m_innerRadius) / max(1.0f - PassSrg::m_constants.m_innerRadius, 0.0001f));

    uint sampleCount = clamp(PassSrg::m_constants.m_sampleCount, 1u, 64u);
    float3 color = originalColor.rgb;

    [loop]
    for (uint i = 1u; i <= sampleCount; ++i)
    {
        float sampleFraction = float(i) / float(sampleCount);
        float2 sampleUv = clamp(uv - direction * PassSrg::m_constants.m_amount * mask * sampleFraction, float2(0.0f, 0.0f), float2(1.0f, 1.0f));
        uint2 samplePixel = uint2(sampleUv * (textureSize - 1.0f));
        color += PassSrg::m_inputColor[samplePixel].rgb;
    }

    PassSrg::m_outputColor[pixel] = float4(color / float(sampleCount + 1u), originalColor.a);
}
