#define USING_COMPUTE_SHADER_LIGHT 1

#ifndef ENABLE_ESM_SHADOW
#define ENABLE_ESM_SHADOW 1
#endif

#define ENABLE_TRANSMISSION 0
#define ENABLE_FULLSCREEN_SHADOW 0
#define ENABLE_CAPSULE_LIGHTS 0
#define ENABLE_QUAD_LIGHTS 0
#define ENABLE_POLYGON_LTC_LIGHTS 0

#include <scenesrg.srgi>
#include <viewsrg.srgi>
#include <Atom/Features/PBR/LightingOptions.azsli>
#include <Atom/Features/PBR/LightingUtils.azsli>
#include <Atom/Features/LightCulling/LightCullingTileIterator.azsli>
#include <Atom/RPI/Math.azsli>
#include "FroxelUtil.azsli"
#include "FroxelDepthBounds.azsli"

// Keep diagnostic counters out of the production shader. Maintaining these counters through
// every light loop extends several live ranges and substantially increases VGPR pressure.
option bool o_volumetricFog_collect_stats = false;
option bool o_volumetricFog_compact_directional_shadow = true;
option bool o_volumetricFog_compact_projected_shadow = true;
option bool o_volumetricFog_depth_bounds = true;
option bool o_volumetricFog_simple_area_lights = true;
option bool o_volumetricFog_spot_gobos = false;
option bool o_volumetricFog_local_light_shadows = true;

ShaderResourceGroup PassSrg : SRG_PerPass_WithFallback
{
    RWTexture3D<float3> m_froxelScatterResult;

    Texture2D<uint> m_froxelMaxVisibleSlice;
    Texture2D<uint4> m_tileLightData;
    StructuredBuffer<uint> m_lightListRemapped;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };

    // Required by the projected and directional shadow filtering helpers.
    Sampler PointSampler
    {
        MinFilter = Point;
        MagFilter = Point;
        MipFilter = Point;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };

    Texture2DArray<float> m_directionalLightShadowmap;
    Texture2DArray<float> m_directionalLightExponentialShadowmap;
    Texture2D<float> m_fullscreenShadow;
    Texture2DArray<float> m_projectedShadowmaps;
    Texture2DArray<float> m_projectedExponentialShadowmap;
}

// Shadow helpers reference resources declared by PassSrg, so include them after the SRG declaration.
#include <Atom/Features/Shadow/DirectionalLightShadow.azsli>
#include <Atom/Features/Shadow/ProjectedShadow.azsli>

static const float3 FogShadowNormal = float3(0, 0, 0);
static const float3 FogAmbientDirection = float3(0, 0, 1);

static const uint FogLightDirectional = 1u << 0;
static const uint FogLightAmbient = 1u << 1;
static const uint FogLightSimplePoint = 1u << 2;
static const uint FogLightSimpleSpot = 1u << 3;
static const uint FogLightPoint = 1u << 4;
static const uint FogLightDisk = 1u << 5;
static const uint FogIteratorValueMask = 0x0000ffffu;
static const uint FogIteratorBudgetMask = 0xffff0000u;
static const uint FogIteratorBudgetStep = 0x00010000u;

struct FogLightResult
{
    float3 m_radiance;
    float3 m_directionToLight;
    float m_distanceToLight;
    float m_visibility;
    bool m_shadowEvaluated;
};

struct FogScatterStats
{
    uint m_listedLights;
    uint m_contributingLights;
    uint m_rejectedLights;
    uint m_shadowEvaluations;
};

FogLightResult MakeEmptyFogLightResult()
{
    FogLightResult result;
    result.m_radiance = 0;
    result.m_directionToLight = 0;
    result.m_distanceToLight = 0;
    result.m_visibility = 1;
    result.m_shadowEvaluated = false;
    return result;
}

bool IsFogLightChannelEnabled(uint lightChannelMask)
{
    return (SceneSrg::m_volumetricFogData.m_lightingChannelMask & lightChannelMask) != 0;
}

uint EvaluateFogLocalLightBudget(float viewDepth)
{
    float budgetDistanceRange = max(
        SceneSrg::m_volumetricFogData.m_lightBudgetFarDistance -
            SceneSrg::m_volumetricFogData.m_lightBudgetNearDistance,
        1.0e-3);
    float distanceFade = saturate(
        (viewDepth - SceneSrg::m_volumetricFogData.m_lightBudgetNearDistance) /
        budgetDistanceRange);
    float lightBudget = lerp(
        float(SceneSrg::m_volumetricFogData.m_maxLocalLightsNear),
        float(SceneSrg::m_volumetricFogData.m_maxLocalLightsFar),
        distanceFade);
    return uint(lightBudget + 0.5);
}

// NVLC indices and sentinels occupy only the lower 16 bits. Preserve a shared
// per-froxel budget in the unused upper half of the iterator's existing value,
// avoiding both another VGPR and per-thread LDS traffic.
uint FogIteratorLoadAdvance(inout LightCullingTileIterator iterator)
{
    uint budgetBits = iterator.m_value & FogIteratorBudgetMask;
    uint value = iterator.m_value & FogIteratorValueMask;
    if (value != NVLC_END_OF_LIST)
    {
        value = iterator.m_lightListRemapped.Load(int(iterator.m_readIndex)).x & FogIteratorValueMask;
        ++iterator.m_readIndex;
    }
    iterator.m_value = budgetBits | value;
    return value;
}

uint FogIteratorGetValue(LightCullingTileIterator iterator)
{
    return iterator.m_value & FogIteratorValueMask;
}

bool FogIteratorIsDone(LightCullingTileIterator iterator)
{
    return !((iterator.m_value & FogIteratorValueMask) < NVLC_END_OF_GROUP);
}

bool HasFogLocalLightBudget(LightCullingTileIterator iterator)
{
    return (iterator.m_value & FogIteratorBudgetMask) != 0;
}

void ConsumeFogLocalLightBudget(inout LightCullingTileIterator iterator)
{
    iterator.m_value -= FogIteratorBudgetStep;
}

// x: contribution fade, y: expensive-detail fade, z: projected attenuation radius in pixels.
// This depends only on the camera and light, so the selected LOD is stable across all froxels.
float3 EvaluateFogLocalLightLod(
    float3 lightPosition,
    float inverseAttenuationRadiusSquared,
    float3 lightIntensity)
{
    if (SceneSrg::m_volumetricFogData.m_lightLodEnabled == 0)
    {
        return float3(1.0, 1.0, 1.0e20);
    }

    float attenuationRadius = rsqrt(max(inverseAttenuationRadiusSquared, 1.0e-12));
    float3 cameraToLight = lightPosition - ViewSrg::m_worldPosition.xyz;
    float inverseCameraDistance = rsqrt(max(dot(cameraToLight, cameraToLight), 1.0e-4));
    float screenHeight = float(
        SceneSrg::m_volumetricFogData.m_froxelCount.y * SceneSrg::m_volumetricFogData.m_tileSize);
    float projectionScale = 0.5 * screenHeight * abs(ViewSrg::m_projectionMatrix[1][1]);
    float projectedRadiusPixels = attenuationRadius * inverseCameraDistance * projectionScale;

    // Preserve exceptionally bright distant lights with intensity-weighted contribution and
    // detail metrics. Dim lights still retain geometric detail until the normal size threshold.
    float peakIntensity = max(lightIntensity.x, max(lightIntensity.y, lightIntensity.z));
    float intensityScale = sqrt(max(peakIntensity, 0.0) /
        SceneSrg::m_volumetricFogData.m_lightLodReferenceIntensity);
    float importancePixels = projectedRadiusPixels * intensityScale;
    float cullStart = SceneSrg::m_volumetricFogData.m_lightLodCullPixels;
    float cullEnd = max(cullStart * 2.0, cullStart + 1.0e-3);
    float contributionFade = smoothstep(cullStart, cullEnd, importancePixels);
    float detailImportancePixels = projectedRadiusPixels * max(intensityScale, 1.0);
    float detailFade = smoothstep(
        SceneSrg::m_volumetricFogData.m_lightLodShadowPixels,
        SceneSrg::m_volumetricFogData.m_lightLodFullPixels,
        detailImportancePixels);
    return float3(contributionFade, detailFade, projectedRadiusPixels);
}

float EvaluateFogLocalLightContributionFade(
    float3 lightPosition,
    float inverseAttenuationRadiusSquared,
    float3 lightIntensity)
{
    if (SceneSrg::m_volumetricFogData.m_lightLodEnabled == 0)
    {
        return 1.0;
    }

    float attenuationRadius = rsqrt(max(inverseAttenuationRadiusSquared, 1.0e-12));
    float3 cameraToLight = lightPosition - ViewSrg::m_worldPosition.xyz;
    float inverseCameraDistance = rsqrt(max(dot(cameraToLight, cameraToLight), 1.0e-4));
    float screenHeight = float(
        SceneSrg::m_volumetricFogData.m_froxelCount.y * SceneSrg::m_volumetricFogData.m_tileSize);
    float projectionScale = 0.5 * screenHeight * abs(ViewSrg::m_projectionMatrix[1][1]);
    float peakIntensity = max(lightIntensity.x, max(lightIntensity.y, lightIntensity.z));
    float intensityScale = sqrt(max(peakIntensity, 0.0) /
        SceneSrg::m_volumetricFogData.m_lightLodReferenceIntensity);
    float importancePixels = attenuationRadius * inverseCameraDistance * projectionScale * intensityScale;
    float cullStart = SceneSrg::m_volumetricFogData.m_lightLodCullPixels;
    float cullEnd = max(cullStart * 2.0, cullStart + 1.0e-3);
    return smoothstep(cullStart, cullEnd, importancePixels);
}

float HenyeyGreenstein(float cosTheta)
{
    float g = SceneSrg::m_volumetricFogVolumeData.m_phaseG;
    float g2 = g * g;
    float denominator = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-5);
    float inverseSqrtDenominator = rsqrt(denominator);
    return (1.0 - g2) * inverseSqrtDenominator * inverseSqrtDenominator * inverseSqrtDenominator / (4.0 * PI);
}

float3 EvaluateFogSingleScattering(FogLightResult light, float3 viewDirection, float extinction)
{
    float phase = HenyeyGreenstein(dot(light.m_directionToLight, viewDirection));
    float lightTransmittance = exp(-extinction * light.m_distanceToLight);
    return light.m_radiance * light.m_visibility * phase * lightTransmittance;
}

// The generic directional-shadow calculator retains arrays for all cascade coordinates, normal
// offsets, derivative state, and every filtering mode. Fog has no surface normal, and the common
// unfiltered/no-blend configuration can stream through the cascades with the same depth test.
float EvaluateFogDirectionalShadowNoFilter(uint lightIndex, float3 worldPosition)
{
    uint shadowmapSize = ViewSrg::m_directionalLightShadows[lightIndex].m_shadowmapSize;
    if (shadowmapSize <= 1)
    {
        return 1.0;
    }

    uint cascadeCount = min(
        ViewSrg::m_directionalLightShadows[lightIndex].m_cascadeCount,
        ViewSrg::MaxCascadeCount);
    float shadowBias = ViewSrg::m_directionalLightShadows[lightIndex].m_shadowBias;
    float xyMin = PIXEL_MARGIN / float(shadowmapSize);
    float xyMax = 1.0 - xyMin;
    bool foundCascade = false;

    for (uint cascade = 0; cascade < cascadeCount; ++cascade)
    {
        float4 lightSpacePosition = mul(
            ViewSrg::m_directionalLightShadows[lightIndex].m_worldToLightViewMatrices[cascade],
            float4(worldPosition, 1.0));
        lightSpacePosition.z += shadowBias;
        float4 shadowPosition = mul(
            ViewSrg::m_directionalLightShadows[lightIndex].m_lightViewToShadowmapMatrices[cascade],
            lightSpacePosition);
        float3 shadowCoord = shadowPosition.xyz / shadowPosition.w;

        if (!foundCascade)
        {
            foundCascade = all(shadowCoord.xy >= xyMin) && all(shadowCoord.xy <= xyMax);
        }
        if (!foundCascade)
        {
            continue;
        }

        float shadowDepth = PassSrg::m_directionalLightShadowmap.SampleLevel(
            PassSrg::PointSampler,
            float3(shadowCoord.xy, cascade),
            0).r;
        if (shadowDepth != 1.0 && shadowCoord.z - shadowDepth > 0.0)
        {
            return 0.0;
        }

        // Once depth is inside a cascade, the generic calculator's maximum cascade is reached.
        if (shadowCoord.z <= 1.0 - DEPTH_MARGIN)
        {
            break;
        }
    }
    return 1.0;
}

float EvaluateFogDirectionalShadow(uint lightIndex, float3 worldPosition, float4 screenPosition)
{
    if (o_volumetricFog_compact_directional_shadow &&
        o_directional_shadow_filtering_method == ShadowFilterMethod::None &&
        !o_blend_between_cascades_enable)
    {
        return EvaluateFogDirectionalShadowNoFilter(lightIndex, worldPosition);
    }
    return DirectionalLightShadow::GetVisibility(
        lightIndex, worldPosition, FogShadowNormal, screenPosition);
}

// Froxels are spatially filtered by integration and temporal history, so one hardware-bilinear
// comparison provides a stable compact PCF footprint without retaining the 4/9/16-tap bicubic
// filter state. The legacy evaluator remains available in the fallback variant.
float EvaluateFogProjectedShadowCompact(uint shadowIndex, float3 worldPosition)
{
    uint shadowmapSize = ViewSrg::m_projectedFilterParams[shadowIndex].m_shadowmapSize;
    if (shadowmapSize <= 1)
    {
        return 1.0;
    }

    float4 shadowPositionHomogeneous = mul(
        ViewSrg::m_projectedShadows[shadowIndex].m_depthBiasMatrix,
        float4(worldPosition, 1.0));
    float inverseW = rcp(shadowPositionHomogeneous.w);
    float3 shadowPosition = shadowPositionHomogeneous.xyz * inverseW;
    float pixelMargin = 1.5 / float(shadowmapSize);
    if (any(shadowPosition.xy < 0.0) || any(shadowPosition.xy > 1.0 - pixelMargin))
    {
        return 1.0;
    }

    uint2 atlasOrigin = ViewSrg::m_projectedFilterParams[shadowIndex].m_shadowmapOriginInSlice;
    uint atlasSlice = ViewSrg::m_projectedShadows[shadowIndex].m_shadowmapArraySlice;
    float2 atlasPosition = shadowPosition.xy * float(shadowmapSize) + float2(atlasOrigin);
    float comparisonDepth = shadowPosition.z - ViewSrg::m_projectedShadows[shadowIndex].m_bias * inverseW;
    return PassSrg::m_projectedShadowmaps.SampleCmpLevelZero(
        SceneSrg::m_hwPcfSampler,
        float3(atlasPosition * ViewSrg::m_invShadowmapAtlasSize, atlasSlice),
        comparisonDepth);
}

float EvaluateFogProjectedShadow(
    uint shadowIndex,
    float3 lightPosition,
    float3 worldPosition,
    float3 directionToLight)
{
    if (o_volumetricFog_compact_projected_shadow)
    {
        return EvaluateFogProjectedShadowCompact(shadowIndex, worldPosition);
    }
    return ProjectedShadow::GetVisibility(
        shadowIndex, lightPosition, worldPosition, directionToLight, FogShadowNormal);
}

FogLightResult EvaluateFogDirectionalLight(uint lightIndex, float3 froxelPosition, float4 screenPosition)
{
    FogLightResult result = MakeEmptyFogLightResult();
    if (!o_enableDirectionalLights)
    {
        return result;
    }

    SceneSrg::DirectionalLight light = SceneSrg::m_directionalLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return result;
    }

    result.m_radiance = light.m_rgbIntensityLux;
    result.m_directionToLight = normalize(-light.m_direction);
    // Preserve the previous one-meter optical-depth approximation for directional lights.
    result.m_distanceToLight = 1.0;
#if ENABLE_SHADOWS
    const uint shadowIndex = ViewSrg::m_shadowIndexDirectionalLight;
    if (any(result.m_radiance > 0) && o_enableShadows && lightIndex == shadowIndex)
    {
        // A participating medium has no surface normal. Zero disables the surface normal offset.
        result.m_visibility = EvaluateFogDirectionalShadow(
            shadowIndex, froxelPosition, screenPosition);
        if (o_volumetricFog_collect_stats)
        {
            result.m_shadowEvaluated = true;
        }
    }
#endif

    return result;
}

FogLightResult EvaluateFogSimplePointLight(uint lightIndex, float3 froxelPosition)
{
    FogLightResult result = MakeEmptyFogLightResult();
    if (!o_enablePunctualLights || !o_enableSimplePointLights)
    {
        return result;
    }

    ViewSrg::SimplePointLight light = ViewSrg::m_simplePointLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return result;
    }

    float3 lightLod = EvaluateFogLocalLightLod(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    if (lightLod.x <= 0.0)
    {
        return result;
    }

    float3 toLight = light.m_position - froxelPosition;
    float distanceSquared = dot(toLight, toLight);
    float range = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (range >= 1.0)
    {
        return result;
    }

    float inverseDistance = rsqrt(max(distanceSquared, 1e-6));
    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;

    result.m_directionToLight = toLight * inverseDistance;
    result.m_distanceToLight = distanceSquared * inverseDistance;
    result.m_radiance = light.m_rgbIntensityCandelas * rangeAttenuation * lightLod.x / max(distanceSquared, 1e-6);
    return result;
}

FogLightResult EvaluateFogSimpleSpotLight(uint lightIndex, float3 froxelPosition)
{
    FogLightResult result = MakeEmptyFogLightResult();
    if (!o_enablePunctualLights || !o_enableSimpleSpotLights)
    {
        return result;
    }

    ViewSrg::SimpleSpotLight light = ViewSrg::m_simpleSpotLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return result;
    }

    float3 lightLod = EvaluateFogLocalLightLod(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    if (lightLod.x <= 0.0)
    {
        return result;
    }

    float3 toLight = light.m_position - froxelPosition;
    float distanceSquared = dot(toLight, toLight);
    float inverseDistance = rsqrt(max(distanceSquared, 1e-6));
    float3 directionToLight = toLight * inverseDistance;
    float coneCosine = dot(directionToLight, -light.m_direction);
    float range = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (range >= 1.0 || coneCosine < light.m_cosOuterConeAngle)
    {
        return result;
    }

    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;
    float coneAttenuation = saturate(
        (coneCosine - light.m_cosOuterConeAngle) /
        max(light.m_cosInnerConeAngle - light.m_cosOuterConeAngle, 1e-5));
    coneAttenuation = coneAttenuation * coneAttenuation * (3.0 - 2.0 * coneAttenuation);

    result.m_directionToLight = directionToLight;
    result.m_distanceToLight = distanceSquared * inverseDistance;
    result.m_radiance = light.m_rgbIntensityCandelas * rangeAttenuation * coneAttenuation * lightLod.x /
        max(distanceSquared, 1e-6);

    if (o_volumetricFog_spot_gobos &&
        lightLod.y > 0.0 && light.m_goboTexIndex < ViewSrg::MaxGoboTextureCount)
    {
        float4 positionInLight = mul(light.m_viewProjectionMatrix, float4(froxelPosition, 1.0));
        float inverseW = rcp(max(abs(positionInLight.w), 1e-5));
        float2 goboUv = positionInLight.xy * inverseW * 0.5 + 0.5;
        float gobo = ViewSrg::m_goboTextures[light.m_goboTexIndex].SampleLevel(
            PassSrg::LinearSampler, goboUv, 0);
        result.m_radiance *= lerp(1.0, gobo, lightLod.y);
    }

#if ENABLE_SHADOWS
    if (o_volumetricFog_local_light_shadows && lightLod.y > 0.0 &&
        any(result.m_radiance > 0) && o_enableShadows &&
        o_enableSimpleSpotLightShadows && light.m_shadowIndex != 0xffff)
    {
        float shadowVisibility = EvaluateFogProjectedShadow(
            light.m_shadowIndex,
            light.m_position,
            froxelPosition,
            directionToLight);
        result.m_visibility = lerp(1.0, shadowVisibility, lightLod.y);
        if (o_volumetricFog_collect_stats)
        {
            result.m_shadowEvaluated = true;
        }
    }
#endif

    return result;
}

uint GetFogPointLightShadowFace(float3 targetPosition, float3 lightPosition)
{
    float3 toPoint = targetPosition - lightPosition;
    float3 absoluteToPoint = abs(toPoint);
    if (absoluteToPoint.x >= absoluteToPoint.y && absoluteToPoint.x >= absoluteToPoint.z)
    {
        return toPoint.x < 0 ? 0 : 1;
    }
    if (absoluteToPoint.y >= absoluteToPoint.z)
    {
        return toPoint.y < 0 ? 2 : 3;
    }
    return toPoint.z < 0 ? 4 : 5;
}

uint UnpackFogPointLightShadowIndex(ViewSrg::PointLight light, uint face)
{
    uint packedIndex = face >> 1;
    uint shift = (face & 1) * 16;
    return (light.m_shadowIndices[packedIndex] >> shift) & 0xffff;
}

FogLightResult EvaluateFogPointLight(uint lightIndex, float3 froxelPosition)
{
    FogLightResult result = MakeEmptyFogLightResult();
    if (!o_enableAreaLights || !o_enableSphereLights)
    {
        return result;
    }

    ViewSrg::PointLight light = ViewSrg::m_pointLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return result;
    }

    float3 lightLod = EvaluateFogLocalLightLod(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    if (lightLod.x <= 0.0)
    {
        return result;
    }

    float3 toLightCenter = light.m_position - froxelPosition;
    float centerDistanceSquared = dot(toLightCenter, toLightCenter);
    float range = centerDistanceSquared * light.m_invAttenuationRadiusSquared;
    if (range >= 1.0)
    {
        return result;
    }

    float inverseCenterDistance = rsqrt(max(centerDistanceSquared, 1e-6));
    float centerDistance = centerDistanceSquared * inverseCenterDistance;
    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;

    result.m_directionToLight = toLightCenter * inverseCenterDistance;
    result.m_distanceToLight = max(centerDistance - light.m_bulbRadius, 0.0);
    result.m_radiance = light.m_rgbIntensityCandelas * rangeAttenuation * lightLod.x /
        max(centerDistanceSquared, 1e-6);
#if ENABLE_SHADOWS
    if (o_volumetricFog_local_light_shadows && lightLod.y > 0.0 &&
        any(result.m_radiance > 0) && o_enableShadows && o_enableSphereLightShadows)
    {
        uint face = GetFogPointLightShadowFace(froxelPosition, light.m_position);
        uint shadowIndex = UnpackFogPointLightShadowIndex(light, face);
        if (shadowIndex != 0xffff)
        {
            float shadowVisibility = EvaluateFogProjectedShadow(
                shadowIndex,
                light.m_position,
                froxelPosition,
                result.m_directionToLight);
            result.m_visibility = lerp(1.0, shadowVisibility, lightLod.y);
            if (o_volumetricFog_collect_stats)
            {
                result.m_shadowEvaluated = true;
            }
        }
    }
#endif

    return result;
}

FogLightResult EvaluateFogDiskLight(uint lightIndex, float3 froxelPosition)
{
    FogLightResult result = MakeEmptyFogLightResult();
    if (!o_enableAreaLights || !o_enableDiskLights)
    {
        return result;
    }

    ViewSrg::DiskLight light = ViewSrg::m_diskLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return result;
    }

    float3 lightLod = EvaluateFogLocalLightLod(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    if (lightLod.x <= 0.0)
    {
        return result;
    }

    float3 toCenter = light.m_position - froxelPosition;
    float centerDistanceSquared = dot(toCenter, toCenter);
    float inverseCenterDistance = rsqrt(max(centerDistanceSquared, 1e-6));
    float3 directionToCenter = toCenter * inverseCenterDistance;
    float facing = dot(directionToCenter, -light.m_direction);
    float range = centerDistanceSquared * light.m_invAttenuationRadiusSquared;
    if (range >= 1.0 || facing <= 0.0)
    {
        return result;
    }

    static const uint UseConeAngle = 1;
    float coneAttenuation = 1.0;
    if ((light.m_flags & UseConeAngle) != 0)
    {
        float3 coneTip = light.m_position - light.m_direction * light.m_bulbPositionOffset;
        float3 directionToConeTip = normalize(coneTip - froxelPosition);
        float coneCosine = dot(directionToConeTip, -light.m_direction);
        if (coneCosine < light.m_cosOuterConeAngle)
        {
            return result;
        }
        coneAttenuation = saturate(
            (coneCosine - light.m_cosOuterConeAngle) /
            max(light.m_cosInnerConeAngle - light.m_cosOuterConeAngle, 1e-5));
        coneAttenuation = coneAttenuation * coneAttenuation * (3.0 - 2.0 * coneAttenuation);
    }

    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;

    if (o_volumetricFog_simple_area_lights ||
        lightLod.z < 0.5 * SceneSrg::m_volumetricFogData.m_lightLodShadowPixels)
    {
        // Once the disk is small on screen, its center-point approximation is visually
        // indistinguishable and avoids the closest-point construction and extra square roots.
        float centerDistance = centerDistanceSquared * inverseCenterDistance;
        result.m_directionToLight = directionToCenter;
        result.m_distanceToLight = max(centerDistance - light.m_diskRadius, 0.0);
        result.m_radiance = light.m_rgbIntensityCandelas * rangeAttenuation * facing * coneAttenuation * lightLod.x /
            max(centerDistanceSquared, max(light.m_diskRadius * light.m_diskRadius, 1e-6));
    }
    else
    {
        float distanceToPlane = max(dot(toCenter, -light.m_direction), 1e-4);
        float radialDistanceSquared = max(centerDistanceSquared - distanceToPlane * distanceToPlane, 0.0);
        float radialDistance = sqrt(radialDistanceSquared);
        float distancePastDisk = max(radialDistance - light.m_diskRadius, 0.0);
        float distanceToDiskSquared = distancePastDisk * distancePastDisk + distanceToPlane * distanceToPlane;

        // Project the froxel-to-center vector onto the disk plane, expressed from the disk center.
        float3 projectedCenterOffset = -toCenter + (-light.m_direction * distanceToPlane);
        float projectedLength = length(projectedCenterOffset);
        float3 closestPoint = light.m_position;
        if (projectedLength > 1e-5)
        {
            closestPoint += projectedCenterOffset / projectedLength * min(projectedLength, light.m_diskRadius);
        }
        float3 toRepresentativePoint = closestPoint - froxelPosition;
        float representativeDistanceSquared = dot(toRepresentativePoint, toRepresentativePoint);
        float inverseRepresentativeDistance = rsqrt(max(representativeDistanceSquared, 1e-6));
        float apparentSizeAttenuation = rcp(light.m_diskRadius / distanceToPlane + 1.0);

        result.m_directionToLight = toRepresentativePoint * inverseRepresentativeDistance;
        result.m_distanceToLight = representativeDistanceSquared * inverseRepresentativeDistance;
        result.m_radiance = light.m_rgbIntensityCandelas * rangeAttenuation * facing * coneAttenuation *
            apparentSizeAttenuation * lightLod.x / max(distanceToDiskSquared, 1e-6);
    }
#if ENABLE_SHADOWS
    if (o_volumetricFog_local_light_shadows && lightLod.y > 0.0 &&
        any(result.m_radiance > 0) && o_enableShadows &&
        o_enableDiskLightShadows && light.m_shadowIndex != 0xffff)
    {
        float shadowVisibility = EvaluateFogProjectedShadow(
            light.m_shadowIndex,
            light.m_position,
            froxelPosition,
            result.m_directionToLight);
        result.m_visibility = lerp(1.0, shadowVisibility, lightLod.y);
        if (o_volumetricFog_collect_stats)
        {
            result.m_shadowEvaluated = true;
        }
    }
#endif

    return result;
}

float3 EvaluateFogUnshadowedScattering(
    float3 radiance,
    float3 directionToLight,
    float distanceToLight,
    float3 viewDirection,
    float extinction)
{
    float phase = HenyeyGreenstein(dot(directionToLight, viewDirection));
    float lightTransmittance = exp(-extinction * distanceToLight);
    return radiance * phase * lightTransmittance;
}

// Low-register local-light evaluators. These retain the same range, cone, phase, channel,
// light-distance extinction, and projected-size LOD behavior as the full evaluators, but
// deliberately omit local shadows, gobos, and finite-area closest-point construction.
float3 EvaluateFogFastSimplePointLight(
    uint lightIndex, float3 froxelPosition, float3 viewDirection, float extinction)
{
    if (!o_enablePunctualLights || !o_enableSimplePointLights)
    {
        return 0;
    }

    ViewSrg::SimplePointLight light = ViewSrg::m_simplePointLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return 0;
    }

    float contributionFade = EvaluateFogLocalLightContributionFade(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    float3 toLight = light.m_position - froxelPosition;
    float distanceSquared = dot(toLight, toLight);
    float range = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (contributionFade <= 0.0 || range >= 1.0)
    {
        return 0;
    }

    float inverseDistance = rsqrt(max(distanceSquared, 1e-6));
    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;
    float3 radiance = light.m_rgbIntensityCandelas * rangeAttenuation * contributionFade /
        max(distanceSquared, 1e-6);
    return EvaluateFogUnshadowedScattering(
        radiance, toLight * inverseDistance, distanceSquared * inverseDistance,
        viewDirection, extinction);
}

float3 EvaluateFogFastSimpleSpotLight(
    uint lightIndex, float3 froxelPosition, float3 viewDirection, float extinction)
{
    if (!o_enablePunctualLights || !o_enableSimpleSpotLights)
    {
        return 0;
    }

    ViewSrg::SimpleSpotLight light = ViewSrg::m_simpleSpotLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return 0;
    }

    float contributionFade = EvaluateFogLocalLightContributionFade(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    float3 toLight = light.m_position - froxelPosition;
    float distanceSquared = dot(toLight, toLight);
    float range = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (contributionFade <= 0.0 || range >= 1.0)
    {
        return 0;
    }

    float inverseDistance = rsqrt(max(distanceSquared, 1e-6));
    float3 directionToLight = toLight * inverseDistance;
    float coneCosine = dot(directionToLight, -light.m_direction);
    if (coneCosine < light.m_cosOuterConeAngle)
    {
        return 0;
    }

    // Consume the normalized direction before constructing RGB radiance so the compiler does
    // not have to retain both float3 values across the final attenuation calculation.
    float phase = HenyeyGreenstein(dot(directionToLight, viewDirection));
    float lightTransmittance = exp(-extinction * distanceSquared * inverseDistance);
    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;
    float coneAttenuation = saturate(
        (coneCosine - light.m_cosOuterConeAngle) /
        max(light.m_cosInnerConeAngle - light.m_cosOuterConeAngle, 1e-5));
    coneAttenuation = coneAttenuation * coneAttenuation * (3.0 - 2.0 * coneAttenuation);
    float scatteringScale = rangeAttenuation * coneAttenuation * contributionFade * phase * lightTransmittance /
        max(distanceSquared, 1e-6);
    return light.m_rgbIntensityCandelas * scatteringScale;
}

float3 EvaluateFogFastPointLight(
    uint lightIndex, float3 froxelPosition, float3 viewDirection, float extinction)
{
    if (!o_enableAreaLights || !o_enableSphereLights)
    {
        return 0;
    }

    ViewSrg::PointLight light = ViewSrg::m_pointLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return 0;
    }

    float contributionFade = EvaluateFogLocalLightContributionFade(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    float3 toLight = light.m_position - froxelPosition;
    float distanceSquared = dot(toLight, toLight);
    float range = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (contributionFade <= 0.0 || range >= 1.0)
    {
        return 0;
    }

    float inverseDistance = rsqrt(max(distanceSquared, 1e-6));
    float distance = distanceSquared * inverseDistance;
    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;
    float3 radiance = light.m_rgbIntensityCandelas * rangeAttenuation * contributionFade /
        max(distanceSquared, 1e-6);
    return EvaluateFogUnshadowedScattering(
        radiance, toLight * inverseDistance, max(distance - light.m_bulbRadius, 0.0),
        viewDirection, extinction);
}

float3 EvaluateFogFastDiskLight(
    uint lightIndex, float3 froxelPosition, float3 viewDirection, float extinction)
{
    if (!o_enableAreaLights || !o_enableDiskLights)
    {
        return 0;
    }

    ViewSrg::DiskLight light = ViewSrg::m_diskLights[lightIndex];
    if (!IsFogLightChannelEnabled(light.m_lightingChannelMask))
    {
        return 0;
    }

    float contributionFade = EvaluateFogLocalLightContributionFade(
        light.m_position, light.m_invAttenuationRadiusSquared, light.m_rgbIntensityCandelas);
    float3 toLight = light.m_position - froxelPosition;
    float distanceSquared = dot(toLight, toLight);
    float inverseDistance = rsqrt(max(distanceSquared, 1e-6));
    float3 directionToLight = toLight * inverseDistance;
    float facing = dot(directionToLight, -light.m_direction);
    float range = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (contributionFade <= 0.0 || range >= 1.0 || facing <= 0.0)
    {
        return 0;
    }

    float phase = HenyeyGreenstein(dot(directionToLight, viewDirection));
    float distanceToLight = max(distanceSquared * inverseDistance - light.m_diskRadius, 0.0);
    float lightTransmittance = exp(-extinction * distanceToLight);

    float coneAttenuation = 1.0;
    static const uint UseConeAngle = 1;
    if ((light.m_flags & UseConeAngle) != 0)
    {
        // The fast path treats the disk as a center-point spotlight. Reusing its already
        // normalized center direction avoids retaining another float3 and reciprocal square root.
        float coneCosine = dot(directionToLight, -light.m_direction);
        if (coneCosine < light.m_cosOuterConeAngle)
        {
            return 0;
        }
        coneAttenuation = saturate(
            (coneCosine - light.m_cosOuterConeAngle) /
            max(light.m_cosInnerConeAngle - light.m_cosOuterConeAngle, 1e-5));
        coneAttenuation = coneAttenuation * coneAttenuation * (3.0 - 2.0 * coneAttenuation);
    }

    float rangeAttenuation = 1.0 - range * range;
    rangeAttenuation *= rangeAttenuation;
    float radiusSquared = max(light.m_diskRadius * light.m_diskRadius, 1e-6);
    float scatteringScale = rangeAttenuation * facing * coneAttenuation * contributionFade * phase *
        lightTransmittance / max(distanceSquared, radiusSquared);
    return light.m_rgbIntensityCandelas * scatteringScale;
}

float3 ApplyFogDirectionalLights(
    float3 froxelPosition,
    float extinction,
    float3 viewDirection,
    float4 screenPosition,
    inout FogScatterStats stats)
{
    min16float3 inScattering = 0;
    for (uint lightIndex = 0; lightIndex < SceneSrg::m_directionalLightCount; ++lightIndex)
    {
        if (o_volumetricFog_collect_stats)
        {
            ++stats.m_listedLights;
        }
        FogLightResult light = EvaluateFogDirectionalLight(lightIndex, froxelPosition, screenPosition);
        if (any(light.m_radiance > 0) && light.m_visibility > 0)
        {
            if (o_volumetricFog_collect_stats)
            {
                ++stats.m_contributingLights;
            }
            inScattering += EvaluateFogSingleScattering(light, viewDirection, extinction);
        }
        else if (o_volumetricFog_collect_stats)
        {
            ++stats.m_rejectedLights;
        }
        if (o_volumetricFog_collect_stats)
        {
            stats.m_shadowEvaluations += light.m_shadowEvaluated ? 1 : 0;
        }
    }
    return inScattering;
}

void DrainActiveFogLightGroup(
    inout LightCullingTileIterator tileIterator,
    inout FogScatterStats stats)
{
    while (!FogIteratorIsDone(tileIterator))
    {
        if (o_volumetricFog_collect_stats)
        {
            ++stats.m_listedLights;
            ++stats.m_rejectedLights;
        }
        FogIteratorLoadAdvance(tileIterator);
    }
}

float3 ApplyFogSimplePointLights(
    float3 froxelPosition,
    float extinction,
    float3 viewDirection,
    inout LightCullingTileIterator tileIterator,
    inout FogScatterStats stats)
{
    min16float3 inScattering = 0;
    FogIteratorLoadAdvance(tileIterator);
    while (!FogIteratorIsDone(tileIterator))
    {
        if (!HasFogLocalLightBudget(tileIterator))
        {
            DrainActiveFogLightGroup(tileIterator, stats);
            break;
        }

        uint lightIndex = FogIteratorGetValue(tileIterator);
        FogIteratorLoadAdvance(tileIterator);
        if (o_volumetricFog_collect_stats)
        {
            ++stats.m_listedLights;
        }

        min16float3 contribution = 0;
        bool shadowEvaluated = false;
        if (o_volumetricFog_local_light_shadows)
        {
            FogLightResult light = EvaluateFogSimplePointLight(lightIndex, froxelPosition);
            if (any(light.m_radiance > 0) && light.m_visibility > 0)
            {
                contribution = EvaluateFogSingleScattering(light, viewDirection, extinction);
            }
            shadowEvaluated = light.m_shadowEvaluated;
        }
        else
        {
            contribution = EvaluateFogFastSimplePointLight(
                lightIndex, froxelPosition, viewDirection, extinction);
        }

        if (any(contribution > 0))
        {
            if (o_volumetricFog_collect_stats)
            {
                ++stats.m_contributingLights;
            }
            inScattering += contribution;
            ConsumeFogLocalLightBudget(tileIterator);
        }
        else if (o_volumetricFog_collect_stats)
        {
            ++stats.m_rejectedLights;
        }
        if (o_volumetricFog_collect_stats)
        {
            stats.m_shadowEvaluations += shadowEvaluated ? 1 : 0;
        }
    }
    return inScattering;
}

