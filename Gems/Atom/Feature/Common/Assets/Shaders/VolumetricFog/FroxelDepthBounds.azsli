#pragma once

uint GetFroxelMaxVisibleSlice(
    uint2 froxelId,
    Texture2D<uint> maxVisibleSliceTexture,
    uint additionalSliceMargin,
    bool depthBoundsEnabled)
{
    uint sliceCount = SceneSrg::m_volumetricFogData.m_froxelCount.z;
    if (!depthBoundsEnabled)
    {
        return sliceCount - 1;
    }

    return min(maxVisibleSliceTexture[froxelId] + additionalSliceMargin, sliceCount - 1);
}
