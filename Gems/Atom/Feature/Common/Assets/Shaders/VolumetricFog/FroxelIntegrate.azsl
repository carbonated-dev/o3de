#include <scenesrg.srgi>
#include <viewsrg.srgi>
#include <Atom/RPI/Math.azsli>
#include "FroxelUtil.azsli"

option bool o_volumetricFog_tiled_neighborhood = true;

ShaderResourceGroup PassSrg : SRG_PerPass_WithFallback
{
    Texture3D<float3>   m_froxelScattered;       // current-frame raw light contribution
    Texture3D<float3>   m_froxelHistory;         // previous-frame temporally-filtered scatter (ping-pong read)
    RWTexture3D<float3> m_froxelTemporalOutput;  // this frame's RGB temporal result (ping-pong write, for next frame)
    Texture3D<float4>   m_froxelMedium;          // per-froxel scattering coefficient (rgb) + extinction (a)
    Texture3D<float4>   m_froxelEmissive;        // per-froxel emissive
    RWTexture3D<float4> m_froxelIntegrated;      // accumulated in-scatter (rgb) + transmittance (a)

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}

static const uint SharedTileWidth = NUM_THREADS_PER_GROUP + 2;
static const uint SharedPlaneCellCount = SharedTileWidth * SharedTileWidth;
static const uint ThreadsPerGroup = NUM_THREADS_PER_GROUP * NUM_THREADS_PER_GROUP;
groupshared uint sharedScatter[3 * SharedPlaneCellCount];

// Scatter is backed by R11G11B10_FLOAT. Repacking through fp16 preserves its effective
// non-negative precision while reducing each LDS cell and load to one 32-bit value.
uint PackSharedScatter(float3 value)
{
    uint r = min((f32tof16(max(value.r, 0.0)) + 0x8) >> 4, 0x7ff);
    uint g = min((f32tof16(max(value.g, 0.0)) + 0x8) >> 4, 0x7ff);
    uint b = min((f32tof16(max(value.b, 0.0)) + 0x10) >> 5, 0x3ff);
    return r | (g << 11) | (b << 22);
}

float3 UnpackSharedScatter(uint value)
{
    return float3(
        f16tof32((value & 0x7ff) << 4),
        f16tof32(((value >> 11) & 0x7ff) << 4),
        f16tof32(((value >> 22) & 0x3ff) << 5));
}

// -----------------------------------------------------------------------
// Reproject a froxel's world position into the previous frame's froxel UVW
// -----------------------------------------------------------------------
bool ReprojectToHistory(float3 posWS, out float3 historyUVW)
{
    historyUVW = 0;
    float4 prevClip = mul(ViewSrg::m_viewProjectionPrevMatrix, float4(posWS, 1.0));
    if (prevClip.w <= 0.0f)
        return false;

    float3 prevNDC     = prevClip.xyz / prevClip.w;
    float2 prevScreenUV = float2(prevNDC.x * 0.5f + 0.5f, 0.5f - prevNDC.y * 0.5f);
    float  prevDepth   = prevClip.w;

    float3 prevUVW = GetFroxelUVW(prevScreenUV, prevDepth);
    if (any(prevUVW < 0.0) || any(prevUVW > 1.0))
        return false;

    historyUVW = prevUVW;
    return true;
}

// -----------------------------------------------------------------------
// Compute AABB of the current-frame values in a 3x3x3 neighborhood
// to clamp history samples and suppress ghosting
// -----------------------------------------------------------------------
void ComputeNeighborhoodAABBGlobal(uint3 center, out float3 minVal, out float3 maxVal)
{
    minVal =  1e10;
    maxVal = -1e10;
    int3 start = max(int3(center) - 1, 0);
    int3 end = min(int3(center) + 1, int3(SceneSrg::m_volumetricFogData.m_froxelCount) - 1);
    for (int z = start.z; z <= end.z; ++z)
    {
        for (int y = start.y; y <= end.y; ++y)
        {
            for (int x = start.x; x <= end.x; ++x)
            {
                float3 s = PassSrg::m_froxelScattered[int3(x, y, z)];
                minVal   = min(minVal, s);
                maxVal   = max(maxVal, s);
            }
        }
    }
}

uint GetSharedScatterIndex(uint plane, uint2 localPosition)
{
    return plane * SharedPlaneCellCount + localPosition.y * SharedTileWidth + localPosition.x;
}

void LoadSharedScatterPlane(
    uint plane,
    uint sourceZ,
    uint groupIndex,
    uint2 groupBase,
    uint2 froxelCountXY)
{
    for (uint cell = groupIndex; cell < SharedPlaneCellCount; cell += ThreadsPerGroup)
    {
        uint2 localPosition = uint2(cell % SharedTileWidth, cell / SharedTileWidth);
        int2 globalPosition = clamp(
            int2(groupBase) + int2(localPosition) - 1,
            0,
            int2(froxelCountXY) - 1);
        sharedScatter[plane * SharedPlaneCellCount + cell] = PackSharedScatter(
            PassSrg::m_froxelScattered[uint3(globalPosition, sourceZ)]);
    }
}

void ComputeNeighborhoodAABBShared(uint2 localCenter, uint z, out float3 minVal, out float3 maxVal)
{
    minVal = 1e10;
    maxVal = -1e10;
    uint currentPlane = z % 3;
    uint previousPlane = z > 0 ? (z + 2) % 3 : currentPlane;
    uint nextPlane = z + 1 < SceneSrg::m_volumetricFogData.m_froxelCount.z
        ? (z + 1) % 3
        : currentPlane;
    int3 radius = min(int3(SceneSrg::m_volumetricFogData.m_froxelCount) - 1, 1);

    [loop]
    for (int zOffset = -radius.z; zOffset <= radius.z; ++zOffset)
    {
        uint plane = zOffset < 0 ? previousPlane : (zOffset > 0 ? nextPlane : currentPlane);
        [loop]
        for (int yOffset = -radius.y; yOffset <= radius.y; ++yOffset)
        {
            [loop]
            for (int xOffset = -radius.x; xOffset <= radius.x; ++xOffset)
            {
                uint2 samplePosition = uint2(int2(localCenter) + int2(xOffset, yOffset));
                float3 sampleValue = UnpackSharedScatter(
                    sharedScatter[GetSharedScatterIndex(plane, samplePosition)]);
                minVal = min(minVal, sampleValue);
                maxVal = max(maxVal, sampleValue);
            }
        }
    }
}

float3 ClipToAABB(float3 history, float3 current, float3 minVal, float3 maxVal)
{
    float3 extents = (maxVal - minVal) * 0.5 + 1e-6;
    float3 delta   = history - current;
    float3 units   = delta / extents;
    float maxUnit = max(abs(units.x), max(abs(units.y), abs(units.z)));
    if (maxUnit <= 1.0)
        return history;
    return clamp(history, minVal, maxVal);
}

float3 LogEncodeRGB(float3 rgb) { return log2(max(rgb, 1e-6)); }
float3 LogDecodeRGB(float3 rgb) { return exp2(rgb); }

// -----------------------------------------------------------------------
// Temporal blend for a single froxel
// -----------------------------------------------------------------------
float3 TemporalBlend(
    uint3 froxelId,
    float3 current,
    float3 minNeighbor,
    float3 maxNeighbor)
{
    // Diagnostics represent the current froxel and must not be smeared by history.
    if (SceneSrg::m_volumetricFogData.m_debugMode != 0 || SceneSrg::m_volumetricFogData.m_frameIndex == 1)
        return current;

    float3 posWS = GetFroxelWorldPosition(froxelId);
    float3 historyUVW;
    if (!ReprojectToHistory(posWS, historyUVW))
        return current;

    float3 cellSize   = 1.0f / float3(SceneSrg::m_volumetricFogData.m_froxelCount);
    float3 clampedUVW = clamp(historyUVW, cellSize * 0.5f, 1.0f - cellSize * 0.5f);
    float3 history = PassSrg::m_froxelHistory.SampleLevel(PassSrg::LinearSampler, clampedUVW, 0);

    float3 historyLog = LogEncodeRGB(history);
    float3 currentLog = LogEncodeRGB(current);
    float3 minLog = LogEncodeRGB(minNeighbor);
    float3 maxLog = LogEncodeRGB(maxNeighbor);
    historyLog = ClipToAABB(historyLog, currentLog, minLog, maxLog);

    float3 blendedLog = lerp(historyLog, currentLog, SceneSrg::m_volumetricFogData.m_blendFactor);
    return LogDecodeRGB(blendedLog);
}

float3 TemporalBlendGlobal(uint3 froxelId)
{
    float3 current = PassSrg::m_froxelScattered[froxelId];
    float3 minNeighbor, maxNeighbor;
    ComputeNeighborhoodAABBGlobal(froxelId, minNeighbor, maxNeighbor);
    return TemporalBlend(froxelId, current, minNeighbor, maxNeighbor);
}

void IntegrateFroxel(
    uint3 froxelId,
    uint z,
    float3 blended,
    float fogNear,
    float fogFar,
    uint froxelCountZ,
    inout float3 accumScatter,
    inout float accumTransparency,
    inout bool doneIntegrating)
{
    if (!doneIntegrating)
    {
        float4 medium = PassSrg::m_froxelMedium[froxelId];
        float3 inScatter = blended * medium.rgb;
        float extinction = medium.a;
        float3 emissive = PassSrg::m_froxelEmissive[froxelId].rgb;

        float sliceDepth = SliceToViewZ(z + 1, fogNear, fogFar, froxelCountZ)
                         - SliceToViewZ(z, fogNear, fogFar, froxelCountZ);
        float sliceTransparency = exp(-extinction * sliceDepth);
        float sliceOpacity = 1.0 - sliceTransparency;
        float scatterFactor = (extinction > 1e-6) ? (sliceOpacity / extinction) : sliceDepth;

        accumScatter += (inScatter + emissive) * accumTransparency * scatterFactor;
        accumTransparency *= sliceTransparency;

        if (accumTransparency < 0.001)
        {
            accumTransparency = 0.0;
            doneIntegrating = true;
        }
    }

    PassSrg::m_froxelIntegrated[froxelId] = float4(accumScatter, accumTransparency);
}

void IntegrateColumnGlobal(uint2 tileID)
{
    float3 accumScatter = 0;
    float accumTransparency = 1.0;
    bool doneIntegrating = false;
    uint froxelCountZ = SceneSrg::m_volumetricFogData.m_froxelCount.z;
    float fogNear = SceneSrg::m_volumetricFogData.m_fogNear;
    float fogFar = SceneSrg::m_volumetricFogData.m_fogFar;

    for (uint z = 0; z < froxelCountZ; ++z)
    {
        uint3 froxelId = uint3(tileID, z);
        float3 blended = TemporalBlendGlobal(froxelId);
        PassSrg::m_froxelTemporalOutput[froxelId] = blended;
        IntegrateFroxel(
            froxelId, z, blended, fogNear, fogFar, froxelCountZ,
            accumScatter, accumTransparency, doneIntegrating);
    }
}

// -----------------------------------------------------------------------
// One thread per (x, y) froxel column; z is iterated in the loop.
// For each slice: temporal blend first, then Beer-Lambert integration.
// -----------------------------------------------------------------------
[numthreads(NUM_THREADS_PER_GROUP, NUM_THREADS_PER_GROUP, 1)]
void MainCS(
    uint2 tileID : SV_DispatchThreadID,
    uint3 groupID : SV_GroupID,
    uint groupIndex : SV_GroupIndex,
    uint3 groupThreadID : SV_GroupThreadID)
{
    uint2 froxelCountXY = SceneSrg::m_volumetricFogData.m_froxelCount.xy;
    if (!o_volumetricFog_tiled_neighborhood)
    {
        if (any(tileID >= froxelCountXY))
        {
            return;
        }
        IntegrateColumnGlobal(tileID);
        return;
    }

    // Edge groups must keep all lanes alive for group barriers, even when some lanes are outside
    // the logical froxel grid.
    bool active = all(tileID < froxelCountXY);
    uint froxelCountZ = SceneSrg::m_volumetricFogData.m_froxelCount.z;
    uint2 groupBase = groupID.xy * NUM_THREADS_PER_GROUP;

    // Prime the rolling window. Boundary samples reuse the current plane, which has the same
    // min/max result as the original clipped neighborhood.
    LoadSharedScatterPlane(0, 0, groupIndex, groupBase, froxelCountXY);
    LoadSharedScatterPlane(1, min(1, froxelCountZ - 1), groupIndex, groupBase, froxelCountXY);
    GroupMemoryBarrierWithGroupSync();

    float3 accumScatter = 0;
    float accumTransparency = 1.0;
    bool doneIntegrating = false;
    float fogNear = SceneSrg::m_volumetricFogData.m_fogNear;
    float fogFar = SceneSrg::m_volumetricFogData.m_fogFar;
    uint2 localCenter = groupThreadID.xy + 1;

    for (uint z = 0; z < froxelCountZ; ++z)
    {
        if (z > 0 && z + 1 < froxelCountZ)
        {
            // Finish all reads from the previous window before overwriting its oldest plane.
            GroupMemoryBarrierWithGroupSync();
            uint nextZ = min(z + 1, froxelCountZ - 1);
            LoadSharedScatterPlane((z + 1) % 3, nextZ, groupIndex, groupBase, froxelCountXY);
            GroupMemoryBarrierWithGroupSync();
        }

        if (active)
        {
            uint3 froxelId = uint3(tileID, z);
            float3 current = UnpackSharedScatter(
                sharedScatter[GetSharedScatterIndex(z % 3, localCenter)]);
            float3 minNeighbor, maxNeighbor;
            ComputeNeighborhoodAABBShared(localCenter, z, minNeighbor, maxNeighbor);
            float3 blended = TemporalBlend(froxelId, current, minNeighbor, maxNeighbor);
            PassSrg::m_froxelTemporalOutput[froxelId] = blended;
            IntegrateFroxel(
                froxelId, z, blended, fogNear, fogFar, froxelCountZ,
                accumScatter, accumTransparency, doneIntegrating);
        }
    }
}
