#include <viewsrg.srgi>

#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>
#include <Atom/Feature/Common/Assets/Shaders/Silhouette/Silhouette.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<uint> m_outlineData;
    Texture2D<float> m_silhouetteDepth;
}

struct PSOutput
{
    float4 m_color : SV_Target0;
};

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;
    OUT.m_color = float4(-1.0, -1.0, -1.0, -1.0);

    uint width;
    uint height;
    PassSrg::m_outlineData.GetDimensions(width, height);

    int2 textureMax = int2(width, height) - 1;
    int2 pixelPosition = clamp(int2(IN.m_position.xy), int2(0, 0), textureMax);

    uint centerData = PassSrg::m_outlineData.Load(int3(pixelPosition, 0));
    uint centerOwner = DecodeSilhouetteOwner(centerData);
    if (centerOwner == SilhouetteBackgroundOwner)
    {
        return OUT;
    }

    float centerDepth = PassSrg::m_silhouetteDepth.Load(int3(pixelPosition, 0));
    real retainedRegion[3][3];
    retainedRegion[1][1] = 1.0;
    bool isBoundary = false;
    const float ownerDepthEpsilon = 0.000001;
    [unroll]
    for (int y = -1; y <= 1; ++y)
    {
        [unroll]
        for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0)
            {
                continue;
            }

            int2 samplePosition = clamp(pixelPosition + int2(x, y), int2(0, 0), textureMax);
            uint sampleData = PassSrg::m_outlineData.Load(int3(samplePosition, 0));
            uint sampleOwner = DecodeSilhouetteOwner(sampleData);

            bool leavesRetainedRegion = sampleOwner == SilhouetteBackgroundOwner;
            if (sampleOwner != centerOwner && !leavesRetainedRegion)
            {
                // The gather pass has already retained the nearest silhouette at
                // each pixel. At a transition between owners, only the nearer
                // side emits a seed. O3DE uses reversed depth, so larger is near.
                float sampleDepth = PassSrg::m_silhouetteDepth.Load(int3(samplePosition, 0));
                bool depthTie = abs(centerDepth - sampleDepth) <= ownerDepthEpsilon;
                leavesRetainedRegion = centerDepth > sampleDepth + ownerDepthEpsilon
                    || (depthTie && centerOwner < sampleOwner);
            }

            retainedRegion[y + 1][x + 1] = leavesRetainedRegion ? 0.0 : 1.0;
            isBoundary = isBoundary || leavesRetainedRegion;
        }
    }

    if (isBoundary)
    {
        // Estimate the outward silhouette normal from the binary coverage mask.
        // Diagonal taps are required to keep sharp corners from becoming rounded.
        real2 outwardGradient;
        outwardGradient.x =
            retainedRegion[0][0] + 2.0 * retainedRegion[1][0] + retainedRegion[2][0]
            - retainedRegion[0][2] - 2.0 * retainedRegion[1][2] - retainedRegion[2][2];
        outwardGradient.y =
            retainedRegion[0][0] + 2.0 * retainedRegion[0][1] + retainedRegion[0][2]
            - retainedRegion[2][0] - 2.0 * retainedRegion[2][1] - retainedRegion[2][2];

        real gradientLengthSq = dot(outwardGradient, outwardGradient);
        real2 outwardNormal = gradientLengthSq > 0.0001
            ? outwardGradient * rsqrt(gradientLengthSq)
            : real2(0.0, 0.0);

        real2 textureSize = real2(width, height);
        real2 sourceUV = (real2(pixelPosition) + 0.5) / textureSize;
        real2 edgeUV = sourceUV + outwardNormal * (0.5 / textureSize);
        OUT.m_color = float4(edgeUV, sourceUV);
    }

    return OUT;
}
