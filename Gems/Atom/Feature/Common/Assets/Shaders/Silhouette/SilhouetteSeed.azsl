#include <viewsrg.srgi>

#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>
#include <Atom/Feature/Common/Assets/Shaders/Silhouette/Silhouette.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass_WithFallback
{
    Texture2D<uint2> m_stencilTex;
}

struct PSOutput
{
    float2 m_color : SV_Target0;
};

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;

    uint stencilVal = PassSrg::m_stencilTex.Load(int3(IN.m_position.xy, 0)).g;
    OUT.m_color = (stencilVal & OutlineInsideMask) > 0 ? IN.m_texCoord : float2(-1.0, -1.0);
    return OUT;
}
