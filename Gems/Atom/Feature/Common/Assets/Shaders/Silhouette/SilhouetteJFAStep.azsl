#include <viewsrg.srgi>
#include <Atom/RPI/Math.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    float m_stepSize;
    Texture2D<float4> m_prevJFA;
}

struct PSOutput
{
    float2 m_color : SV_Target0;
};

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;

    real2 position = IN.m_position.xy;
    real2 uv = IN.m_texCoord;
    real2 step  = PassSrg::m_stepSize;
    real2 best  = float2(0, 0);
    real bestDist = FLOAT_16_MAX;

    // 3x3 neighbourhood at current step size
    [unroll]
    for (int dy = -1; dy <= 1; ++dy)
    {
        [unroll]
        for (int dx = -1; dx <= 1; ++dx)
        {
            real2 samplePos  = position + real2(dx, dy) * step;
            real2 seedUV    = PassSrg::m_prevJFA.Load(int3(samplePos, 0));
            if (seedUV.x >= 0.0 && seedUV.y >= 0.0)
            {
                real dist = length(uv - seedUV);
                if (dist < bestDist)
                {
                    bestDist = dist;
                    best  = seedUV;
                }
            }
        }
    }
    OUT.m_color = best;
    return OUT;
}
