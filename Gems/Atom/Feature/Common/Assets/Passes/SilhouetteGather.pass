{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "SilhouetteGatherPassTemplate",
            "PassClass": "RasterPass",
            "Slots": [
                {
                    "Name": "Output",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "RenderTarget",
                    "LoadStoreAction": {
                        "ClearValue": {
                            "Value": [
                                0.0,
                                0.0,
                                0.0,
                                0.0
                            ]
                        },
                        "LoadAction": "Clear"
                    }
                },
                {
                    "Name": "OutlineData",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "RenderTarget",
                    "LoadStoreAction": {
                        "ClearValue": {
                            "Value": [
                                0.0,
                                0.0,
                                0.0,
                                0.0
                            ]
                        },
                        "LoadAction": "Clear"
                    }
                },
                {
                    "Name": "OutlineDepth",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "RenderTarget",
                    "LoadStoreAction": {
                        "ClearValue": {
                            "Value": [
                                0.0,
                                0.0,
                                0.0,
                                0.0
                            ]
                        },
                        "LoadAction": "Clear"
                    }
                },
                {
                    "Name": "DepthStencilInput",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "DepthStencil"
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "OutputImageAttachment",
                    "SizeSource": {
                        "Source": {
                            "Pass": "Parent",
                            "Attachment": "InputOutput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R8G8B8A8_UNORM",
                        "SharedQueueMask": "Graphics"
                    }
                },
                {
                    "Name": "OutlineDataImageAttachment",
                    "SizeSource": {
                        "Source": {
                            "Pass": "Parent",
                            "Attachment": "InputOutput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R8_UINT",
                        "SharedQueueMask": "Graphics"
                    }
                },
                {
                    "Name": "OutlineDepthImageAttachment",
                    "SizeSource": {
                        "Source": {
                            "Pass": "Parent",
                            "Attachment": "InputOutput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R32_FLOAT",
                        "SharedQueueMask": "Graphics"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "Output",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "OutputImageAttachment"
                    }
                },
                {
                    "LocalSlot": "OutlineData",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "OutlineDataImageAttachment"
                    }
                },
                {
                    "LocalSlot": "OutlineDepth",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "OutlineDepthImageAttachment"
                    }
                }
            ],
            "PassData": {
                "$type": "RasterPassData",
                "DrawListTag": "silhouette",
                "BindViewSrg": true
            }
        }
    }
}
