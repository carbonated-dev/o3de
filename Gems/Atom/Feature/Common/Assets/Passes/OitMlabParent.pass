                            "HeightMultiplier": 4.0
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT"
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "OitMlabFragmentCount",
                    "AttachmentRef": {
