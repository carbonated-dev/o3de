                },
                {
                    "Name": "OitMlabFragmentCount",
                    "SlotType": "InputOutput"
                },
                {
                    "Name": "OitMlabFragmentColor",
                    "SlotType": "InputOutput"
                },
                {
                    "Name": "OitMlabFragmentDepthTransmission",
                    "SlotType": "InputOutput"
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "OitMlabFragmentCountImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "InputOutput"
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R32_UINT"
                    }
                },
                {
                    "Name": "OitMlabFragmentColorImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "InputOutput"
                        },
                        "Multipliers": {
                            "WidthMultiplier": 1.0,
                            "HeightMultiplier": 4.0
                        }
                    },
                    "ImageDescriptor": {
                        "Format": "R16G16B16A16_FLOAT"
                    }
                },
                {
                    "Name": "OitMlabFragmentDepthTransmissionImage",
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "InputOutput"
                        },
                        "Multipliers": {
