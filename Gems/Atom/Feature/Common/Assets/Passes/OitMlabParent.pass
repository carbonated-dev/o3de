                            "AttachmentRef": {
                                "Pass": "Parent",
                                "Attachment": "OitMlabFragmentDepthTransmission"
                            }
                        }
                    ],
                    "PassData": {
                        "$type": "RasterPassData",
                        "DrawListTag": "transparent",
                        "DrawListSortType": "KeyThenDepth",
                        "BindViewSrg": true,
                        "PassSrgShaderAsset": {
                            "FilePath": "Shaders/ForwardPassSrg.shader"
                        }
                    }
                },
                {
                    "Name": "OitMlabResolvePass",
                    "TemplateName": "OitMlabResolveTemplate",
                    "Connections": [
                        {
                            "LocalSlot": "InputOutput",
