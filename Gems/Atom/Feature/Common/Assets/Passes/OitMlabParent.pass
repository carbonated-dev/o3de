{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "OitMlabParentTemplate",
            "PassClass": "OitMlabParentPass",
            "Slots": [
                {
                    "Name": "DirectionalShadowmap",
                    "SlotType": "Input"
                },
                {
                    "Name": "DirectionalESM",
                    "SlotType": "Input"
                },
                {
                    "Name": "ProjectedShadowmap",
                    "SlotType": "Input"
                },
                {
                    "Name": "ProjectedESM",
