#ifndef AZ_COLLECTING_PARTIAL_SRGS
#error Do not include this file directly. Include the main .srgi file instead.
#endif

partial ShaderResourceGroup SceneSrg
{
    // Scene-wide OIT settings are stored here so every transparent shader sees the same method parameters.
    uint m_oitMlabLayerCount;
    uint m_oitMlabDebugMode;
    float m_oitWboitWeightScale;
    float m_oitWboitWeightBias;
    float m_oitWboitWeightMax;
    uint m_oitWboitDebugMode;
    uint m_oitMboitMomentCount;
    float m_oitMboitMomentBias;
    float m_oitMboitOverestimation;
    uint m_oitMboitDebugMode;
}
